{
  "name": "splendor-marvel-automa",
  "private": true,
  "version": "0.1.0",
  "description": "Phone-first companion app for playing Splendor Marvel solo against the fan-made Thanos automa.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/screenshots.mjs",
    "site": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-site.mjs",
    "site:shots": "vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/screenshots.mjs --lang ru,sr,es,de --only 02,04,05,06,07,08,09,10,11,12,14,15",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sim.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "reference": "gh release download reference-docs --dir docs/reference --pattern \"*.pdf\" --clobber"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.14.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
